# Credenciales de Postgres (las usa docker-compose para crear la base de datos)
DB_USER=postgres
DB_PASS=postgres
DB_NAME=notifications

# Clave para firmar los JWT. Cámbiala por un valor aleatorio largo.
SECRET_KEY_JWT=cambia-esta-clave

# URLs para ejecutar fuera de Docker (en docker-compose se sobrescriben apuntando al host "db")
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/notifications
ASYNC_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/notifications

# Opcional. Por defecto "localhost"; en docker-compose se usa "redis".
# REDIS_HOST=localhost
